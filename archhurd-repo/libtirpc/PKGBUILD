# Contributor: Tom Gundersen <teg@jklm.no>
# Contributor: Tobias Powalowski <tpowa@archlinux.org>

pkgname=libtirpc
pkgver=1.3.8
pkgrel=1
pkgdesc="Transport Independent RPC library (SunRPC replacement)"
arch=('x86_64')
url="http://git.linux-nfs.org/?p=steved/libtirpc.git;a=summary"
license=('SISSL' 'BSD-3-Clause')
depends=('krb5' 'glibc')
backup=('etc/netconfig')
# git tree: git://linux-nfs.org/~steved/libtirpc
source=(https://downloads.sourceforge.net/sourceforge/libtirpc/${pkgname}-${pkgver}.tar.bz2
        03-kfreebsd.diff
        05-hurd-port.diff
        06-hurd-client-port.diff )
sha1sums=('fe35ce7e81ccfa974c74ced9ac725207af9fa318'
          'SKIP'
          'SKIP'
          'SKIP')
sha512sums=('390c06b8beeb2b0110ab68953d23fef10c823f598146c7fcebce0cb461d6112d0163eded09fd0b5d3e82d0e189a48184ab3d09b994a41f5cbe4799c16eb1a117'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
  cd ${pkgname}-${pkgver}
  patch -Np1 -i "../03-kfreebsd.diff"
  patch -Np1 -i "../05-hurd-port.diff"
  patch -Np1 -i "../06-hurd-client-port.diff"
  autoreconf -fi
}

build() {
  cd ${pkgname}-${pkgver}
  ./configure --prefix=/usr --sysconf=/etc --disable-gssapi
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

package() {
  cd ${pkgname}-${pkgver}
  make DESTDIR="${pkgdir}" install
  install -D -m644 COPYING "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE
}
